{
  "name": "@leoherzog/femto",
  "version": "3.0.0-alpha.1",
  "description": "Semantic HTML, styled with plain CSS: light and dark schemes, 20 theme colors, no build step",
  "license": "MIT",
  "author": {
    "name": "Leo Herzog",
    "url": "https://github.com/leoherzog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoherzog/femto.git"
  },
  "keywords": [
    "css",
    "css-framework",
    "dark-mode",
    "dark-theme",
    "lightweight",
    "minimal",
    "minimalist",
    "minimalistic",
    "native-html",
    "semantic"
  ],
  "main": "dist/femto.min.css",
  "style": "dist/femto.min.css",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/femto.min.css",
    "./css/*": "./css/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "css/",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "Chrome >= 125",
    "Edge >= 125",
    "Firefox >= 128",
    "Safari >= 17.5",
    "iOS >= 17.5",
    "Samsung >= 27"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint css",
    "prepublishOnly": "npm run build && git diff --exit-code -- dist",
    "version": "npm run build && git add dist"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0"
  }
}
