{
  "name": "femto.css",
  "version": "3.0.0-dev",
  "description": "Minimal CSS framework for semantic HTML, written as plain CSS modules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoherzog/femto.git"
  },
  "keywords": [
    "css",
    "css-framework",
    "dark-mode",
    "dark-theme",
    "lightweight",
    "minimal",
    "minimalist",
    "minimalistic",
    "native-html",
    "semantic"
  ],
  "main": "dist/femto.min.css",
  "style": "dist/femto.min.css",
  "exports": {
    ".": "./dist/femto.min.css",
    "./css/*": "./css/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "css/",
    "dist/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint css"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0"
  }
}
